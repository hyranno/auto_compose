{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VariantParameters",
  "description": "The parameters of a variant, as in the JSON file\n(`resources/VariantGenParams_default.json`).",
  "type": "object",
  "properties": {
    "seed": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "resolution": {
      "description": "Replaces the resolution of the base parameters.",
      "$ref": "#/$defs/Resolution"
    },
    "timespan": {
      "description": "The weights of the timespans.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "weight": {
            "type": "number",
            "format": "double"
          },
          "value": {
            "$ref": "#/$defs/Timespan"
          }
        },
        "required": [
          "weight",
          "value"
        ]
      }
    },
    "layer": {
      "description": "The weights of the layers.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "weight": {
            "type": "number",
            "format": "double"
          },
          "value": {
            "$ref": "#/$defs/Layer"
          }
        },
        "required": [
          "weight",
          "value"
        ]
      }
    }
  },
  "required": [
    "seed",
    "resolution",
    "timespan",
    "layer"
  ],
  "$defs": {
    "Resolution": {
      "type": "string",
      "enum": [
        "perfect_authentic",
        "imperfect_authentic",
        "deceptive",
        "plagal",
        "half"
      ]
    },
    "Timespan": {
      "description": "A span of time in beats. The items strictly inside it are varied.",
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "format": "double"
        },
        "end": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "Layer": {
      "description": "The layer to vary.",
      "type": "string",
      "enum": [
        "cadence",
        "chord",
        "pitch",
        "rhythm"
      ]
    }
  }
}
