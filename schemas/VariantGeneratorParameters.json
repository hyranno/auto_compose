{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VariantParameters",
  "description": "The parameters of a variant, as in the JSON file\n(`resources/VariantGenParams_default.json`).",
  "type": "object",
  "properties": {
    "seed": {
      "$ref": "#/$defs/RandomSeed"
    },
    "resolution": {
      "description": "Replaces the resolution of the base parameters.",
      "$ref": "#/$defs/Resolution"
    },
    "timespan": {
      "description": "The weights of the timespans `[start, end]` in beats. Only the items strictly inside are\nchanged.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "weight": {
            "type": "number",
            "format": "double"
          },
          "value": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "weight",
          "value"
        ]
      }
    },
    "layer": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "weight": {
            "type": "number",
            "format": "double"
          },
          "value": {
            "$ref": "#/$defs/Layer"
          }
        },
        "required": [
          "weight",
          "value"
        ]
      }
    }
  },
  "required": [
    "seed",
    "resolution",
    "timespan",
    "layer"
  ],
  "$defs": {
    "RandomSeed": {
      "description": "Seed of a [`ReliableRandom`].\n\nThe parts are read from JSON like JavaScript reads them: the number is taken\nas a `f64` (as `JSON.parse` does) and then converted like `BigInt(x) & U64_MASK`, i.e. to the\ntwo's complement of the integer modulo 2^64. A number that is not an integer is an error\n(`BigInt` throws).",
      "type": "object",
      "properties": {
        "state": {
          "type": "integer",
          "format": "int64"
        },
        "sequence": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "state",
        "sequence"
      ]
    },
    "Resolution": {
      "type": "string",
      "enum": [
        "Perfect authentic",
        "Imperfect authentic",
        "Deceptive",
        "Plagal",
        "Half"
      ]
    },
    "Layer": {
      "description": "The layer to vary: 0 cadence, 1 chord, 2 pitch, 3 rhythm.",
      "enum": [
        0,
        1,
        2,
        3
      ]
    }
  }
}
