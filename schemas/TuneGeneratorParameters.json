{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TuneParameters",
  "description": "The parameters of a tune, as in the JSON files (`resources/TuneGenParams_*.json`).",
  "type": "object",
  "properties": {
    "seed": {
      "description": "The seed of every layer that has no seed of its own.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "scale": {
      "$ref": "#/$defs/Scale"
    },
    "time_measure": {
      "$ref": "#/$defs/TimeMeasure"
    },
    "resolution": {
      "$ref": "#/$defs/Resolution"
    },
    "cadence": {
      "$ref": "#/$defs/CadenceParameters"
    },
    "chord": {
      "$ref": "#/$defs/ChordParameters"
    },
    "rhythm": {
      "$ref": "#/$defs/RhythmParameters"
    },
    "pitch": {
      "$ref": "#/$defs/PitchParameters"
    }
  },
  "required": [
    "seed",
    "scale",
    "time_measure",
    "resolution",
    "cadence",
    "chord",
    "rhythm",
    "pitch"
  ],
  "$defs": {
    "Scale": {
      "type": "object",
      "properties": {
        "key": {
          "type": "integer",
          "format": "int32"
        },
        "tones": {
          "description": "Offsets from the key in semitones.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "required": [
        "key",
        "tones"
      ]
    },
    "TimeMeasure": {
      "description": "The length of a tune.",
      "type": "object",
      "properties": {
        "beats_per_bar": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bars": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "beats_per_bar",
        "bars"
      ]
    },
    "Resolution": {
      "type": "string",
      "enum": [
        "perfect_authentic",
        "imperfect_authentic",
        "deceptive",
        "plagal",
        "half"
      ]
    },
    "CadenceParameters": {
      "type": "object",
      "properties": {
        "seed": {
          "description": "Replaces the seed of the tune for this layer.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "duration": {
          "description": "The length of a cadence in beats.",
          "type": "number",
          "format": "double"
        },
        "transitions": {
          "description": "The transition weights from each cadence to each cadence.",
          "type": "object",
          "properties": {
            "tonic": {
              "description": "A value for each cadence.",
              "type": "object",
              "properties": {
                "tonic": {
                  "type": "number",
                  "format": "double"
                },
                "dominant": {
                  "type": "number",
                  "format": "double"
                },
                "subdominant": {
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "tonic",
                "dominant",
                "subdominant"
              ]
            },
            "dominant": {
              "description": "A value for each cadence.",
              "type": "object",
              "properties": {
                "tonic": {
                  "type": "number",
                  "format": "double"
                },
                "dominant": {
                  "type": "number",
                  "format": "double"
                },
                "subdominant": {
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "tonic",
                "dominant",
                "subdominant"
              ]
            },
            "subdominant": {
              "description": "A value for each cadence.",
              "type": "object",
              "properties": {
                "tonic": {
                  "type": "number",
                  "format": "double"
                },
                "dominant": {
                  "type": "number",
                  "format": "double"
                },
                "subdominant": {
                  "type": "number",
                  "format": "double"
                }
              },
              "required": [
                "tonic",
                "dominant",
                "subdominant"
              ]
            }
          },
          "required": [
            "tonic",
            "dominant",
            "subdominant"
          ]
        }
      },
      "required": [
        "duration",
        "transitions"
      ]
    },
    "ChordParameters": {
      "type": "object",
      "properties": {
        "seed": {
          "description": "Replaces the seed of the tune for this layer.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "roots": {
          "description": "The weights of the root degrees for each cadence.",
          "type": "object",
          "properties": {
            "tonic": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "weight": {
                    "type": "number",
                    "format": "double"
                  },
                  "value": {
                    "type": "integer",
                    "format": "int32"
                  }
                },
                "required": [
                  "weight",
                  "value"
                ]
              }
            },
            "dominant": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "weight": {
                    "type": "number",
                    "format": "double"
                  },
                  "value": {
                    "type": "integer",
                    "format": "int32"
                  }
                },
                "required": [
                  "weight",
                  "value"
                ]
              }
            },
            "subdominant": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "weight": {
                    "type": "number",
                    "format": "double"
                  },
                  "value": {
                    "type": "integer",
                    "format": "int32"
                  }
                },
                "required": [
                  "weight",
                  "value"
                ]
              }
            }
          },
          "required": [
            "tonic",
            "dominant",
            "subdominant"
          ]
        },
        "tones": {
          "description": "The weights of the tones (degrees from the root).",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "weight": {
                "type": "number",
                "format": "double"
              },
              "value": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            },
            "required": [
              "weight",
              "value"
            ]
          }
        }
      },
      "required": [
        "roots",
        "tones"
      ]
    },
    "RhythmParameters": {
      "type": "object",
      "properties": {
        "seed": {
          "description": "Replaces the seed of the tune for this layer.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "max_beat_division_depth": {
          "description": "How many times a beat can be divided into halves.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "p_branch": {
          "description": "The probability to divide a node, by its duration.",
          "$ref": "#/$defs/SmoothstepParams"
        },
        "p_note_on": {
          "description": "The probability that a leaf is a note rather than a rest, by its duration.",
          "$ref": "#/$defs/SmoothstepParams"
        }
      },
      "required": [
        "max_beat_division_depth",
        "p_branch",
        "p_note_on"
      ]
    },
    "SmoothstepParams": {
      "description": "The edges of a [`smoothstep`].",
      "type": "object",
      "properties": {
        "edge0": {
          "type": "number",
          "format": "double"
        },
        "edge1": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "edge0",
        "edge1"
      ]
    },
    "PitchParameters": {
      "type": "object",
      "properties": {
        "seed": {
          "description": "Replaces the seed of the tune for this layer.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "abs_pitch_factor": {
          "description": "Lowers the weight by the distance from the key of the scale.",
          "$ref": "#/$defs/SmoothstepParams"
        },
        "rel_pitch_factor": {
          "description": "Lowers the weight by the distance from the previous pitch.",
          "$ref": "#/$defs/SmoothstepParams"
        },
        "factor_in_scale": {
          "type": "number",
          "format": "double"
        },
        "factor_in_chord": {
          "type": "number",
          "format": "double"
        },
        "rhythm_exponent_factor": {
          "description": "Longer notes sharpen the distribution: the weight is raised to\n`1 + duration * rhythm_exponent_factor`.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "abs_pitch_factor",
        "rel_pitch_factor",
        "factor_in_scale",
        "factor_in_chord",
        "rhythm_exponent_factor"
      ]
    }
  }
}
