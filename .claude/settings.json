{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "pr": ""
  },
  "env": {
    "WASM_PACK_CACHE": "/tmp/claude/wasm-pack",
    "npm_config_cache": "/tmp/claude/npm"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git range-diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git grep *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git rev-parse *)",
      "Bash(git cat-file *)",
      "Bash(gh auth status *)",
      "Bash(gh repo view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue status *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh label list *)",
      "Bash(gh search *)"
    ],
    "ask": [
      "Edit(//**/.devcontainer/**)",
      "Edit(//**/.vscode/**)"
    ],
    "deny": [
      "Read(//**/*.env*)",
      "Read(//**/secrets/**)",
      "Read(//**/credentials*)",
      "Read(//**/*.key)",
      "Read(//**/*.pem)",
      "Read(//**/*.tfvars)",
      "Read(//**/*.tfstate*)",
      "Read(//**/.git-credentials)",
      "Read(//**/.netrc)",
      "Read(//**/.npmrc)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/*kubeconfig*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.zshrc)",
      "Read(~/.zshenv)",
      "Read(~/.bashrc)",
      "Read(~/.bash_profile)",
      "Edit(//**/*.env*)",
      "Edit(//**/secrets/**)",
      "Edit(//**/credentials*)",
      "Edit(//**/*.key)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.tfvars)",
      "Edit(//**/*.tfstate*)",
      "Edit(//**/.git-credentials)",
      "Edit(//**/.netrc)",
      "Edit(//**/.npmrc)",
      "Edit(//**/id_rsa*)",
      "Edit(//**/id_ed25519*)",
      "Edit(//**/*kubeconfig*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.config/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Bash(git credential *)",
      "Bash(git remote *)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh auth refresh *)",
      "Bash(gh auth setup-git *)",
      "Bash(gh auth switch *)",
      "Bash(gh auth token *)",
      "Bash(gh alias *)",
      "Bash(gh config set *)",
      "Bash(gh extension *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh api *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr review *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr lock *)",
      "Bash(gh pr unlock *)",
      "Bash(gh pr update-branch *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh issue pin *)",
      "Bash(gh issue unpin *)",
      "Bash(gh issue lock *)",
      "Bash(gh issue unlock *)",
      "Bash(gh issue develop *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo fork *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo unarchive *)",
      "Bash(gh repo sync *)",
      "Bash(gh repo deploy-key *)",
      "Bash(gh repo autolink *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(gh release delete-asset *)",
      "Bash(gh release upload *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh label create *)",
      "Bash(gh label edit *)",
      "Bash(gh label delete *)",
      "Bash(gh label clone *)",
      "Bash(gh cache delete *)",
      "Bash(gh gist *)",
      "Bash(gh project *)",
      "Bash(gh codespace *)",
      "Bash(gh ruleset *)",
      "Bash(gh attestation *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "code.claude.com",
        "api.anthropic.com",
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "static.rust-lang.org",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "registry.npmjs.org",
        "nodejs.org",
        "mise-versions.jdx.dev"
      ]
    },
    "filesystem": {
      "denyWrite": [
        "//**/*.env*",
        "//**/*.conf",
        "//**/secrets/**",
        "//**/credentials*",
        "//**/*.key",
        "//**/*.pem",
        "//**/*.tfvars",
        "//**/*.tfstate*",
        "//**/.git-credentials",
        "//**/.netrc",
        "//**/.npmrc",
        "//**/id_rsa*",
        "//**/id_ed25519*",
        "//**/*kubeconfig*",
        "//**/.devcontainer/**",
        "//**/.vscode/**",
        "~/.ssh/**",
        "~/.aws/**",
        "~/.docker/config.json",
        "~/.config/**",
        "~/.kube/**",
        "~/.zshrc",
        "~/.zshenv",
        "~/.bashrc",
        "~/.bash_profile",

        "//usr/local/cargo/bin/**",
        "//usr/local/cargo/env",
        "//usr/local/cargo/config",
        "//usr/local/cargo/config.toml"
      ],
      "allowWrite": [
        "//var/lib/xkb",
        "//usr/local/cargo"
      ],
      "denyRead": [
        "//**/*.env*",
        "//**/*.conf",
        "//**/secrets/**",
        "//**/credentials*",
        "//**/*.key",
        "//**/*.pem",
        "//**/*.tfvars",
        "//**/*.tfstate*",
        "//**/.git-credentials",
        "//**/.netrc",
        "//**/.npmrc",
        "//**/id_rsa*",
        "//**/id_ed25519*",
        "//**/*kubeconfig*",
        "~/.ssh/**",
        "~/.aws/**",
        "~/.docker/config.json",
        "~/.kube/**",
        "~/.zshrc",
        "~/.zshenv",
        "~/.bashrc",
        "~/.bash_profile"
      ]
    }
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
